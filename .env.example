# ============================================
# ExtraHand User Service - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control!

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=4001

# ============================================
# MongoDB Configuration
# ============================================
# MongoDB connection string
# Format: mongodb://[username:password@]host[:port][/database][?options]
# Examples:
#   - Local: mongodb://localhost:27017
#   - Atlas: mongodb+srv://username:password@cluster.mongodb.net
#   - With DB: mongodb://localhost:27017/extrahand
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=extrahand

# ============================================
# Firebase Configuration
# ============================================
# Option 1: Use serviceAccountKey.json file (RECOMMENDED for local development)
# Place serviceAccountKey.json in the service root directory (extrahand-user-service/)
# No additional env vars needed if using this method

# Option 2: Primary Firebase (web app — extrahand-app)
# FIREBASE_PROJECT_ID=extrahand-app
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@extrahand-app.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 2b: Mobile apps (extrahand-mobile-app / extrahand-helper-mobile-app) use Firebase project extrahand-ca02c.
# Download a service account key from Firebase Console → extrahand-ca02c → Project settings → Service accounts.
# Either place serviceAccountKey-mobile.json in this directory, or set:
# FIREBASE_MOBILE_PROJECT_ID=extrahand-ca02c
# FIREBASE_MOBILE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@extrahand-ca02c.iam.gserviceaccount.com
# FIREBASE_MOBILE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_MOBILE_SERVICE_ACCOUNT_PATH=./serviceAccountKey-mobile.json

# Option 3: Use custom path to service account file
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# Option 4: Use Google Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Firebase Web API Key (for login endpoint)
# Get from Firebase Console > Project Settings > General > Web API Key
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Firebase Auth Emulator (for local testing)
# Uncomment if using Firebase Auth Emulator:
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ============================================
# Dev-only: Test users for localhost OTP bypass (no reCAPTCHA)
# ============================================
# Set LOCAL_TEST=true to enable POST /auth/otp/complete-dev
# Run: npm run seed to create test users in Firebase + MongoDB
# Credentials (hardcoded in code): +919876543210/OTP 123456, +919876543211/OTP 654321
# LOCAL_TEST=true

# ============================================
# Service-to-Service Communication
# ============================================
# Shared secret token for inter-service authentication
# MUST be the same across all services
# Generate a strong random token: openssl rand -hex 32
SERVICE_AUTH_TOKEN=your-shared-secret-token-here
# Optional dedicated pepper for ReferralRewardConsumption phoneHash (min 16 chars)
REFERRAL_PHONE_HASH_SECRET=

# Other service URLs (for inter-service calls)
TASK_SERVICE_URL=http://localhost:4002
PAYMENT_SERVICE_URL=http://localhost:4009
MESSAGING_SERVICE_URL=http://localhost:4010
VERIFICATION_SERVICE_URL=http://localhost:4004

# ============================================
# Storage Configuration
# ============================================
# Storage provider: 'minio' or 's3'
STORAGE_PROVIDER=minio

# MinIO Configuration (for local development or CapRover)
MINIO_ENDPOINT=localhost
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Alternative naming (CapRover uses these):
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=extrahand-images
MINIO_PUBLIC_DOMAIN=http://localhost:9000
# For CapRover deployment:
# MINIO_SERVER_URL=https://your-minio-domain.com
# MINIO_REGION_NAME=us-east-1

# AWS S3 Configuration (alternative to MinIO)
# Uncomment if using AWS S3 instead of MinIO:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET_NAME=extrahand-images
# AWS_CLOUDFRONT_DOMAIN=https://your-cloudfront-domain.com

# ============================================
# Security & Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================
# Session Token Configuration
# ============================================
# Generate long random secrets (at least 32 chars)
# ACCESS_TOKEN_SECRET must be identical in extrahand-api-gateway .env (gateway verifies tokens we sign)
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=eh_refresh_token
# Optional: lock cookies to a parent domain (e.g., .extrahand.in)
# SESSION_COOKIE_DOMAIN=

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# Default origins are already included (localhost:3000, localhost:4000, etc.)
# Add production domains here:
# CORS_ORIGIN=https://extrahand.in,https://www.extrahand.in

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
# Options: error, warn, info, debug

# ============================================
# Health Check
# ============================================
HEALTH_CHECK_PATH=/api/v1/health

# ============================================
# Play Store review / demo bypass (optional)
# ============================================
# Two dedicated test Firebase Auth users (different phones):
#   Account 1 — Task poster:  +919999999999  (create tasks, accept applications, pay / escrow bypass)
#   Account 2 — Tasker:       +918888888888  (browse, apply, start task after assign)
# Use your project’s test OTP for phone login (e.g. Firebase Auth test config).
#
# PLAY_REVIEW_BYPASS_PHONES must list BOTH numbers (comma-separated, +91 or 10 digits OK).
# Matches profile phone on GET /profiles/me (last 10 digits) → verified flags + reviewBypassActive.
# Demo phones (+919999999999, +918888888888, local-test-*, etc.) also persist is*Verified=true on login/signup and GET /me.
# Set the SAME PLAY_REVIEW_BYPASS_PHONES on payment-service when using Razorpay skip for those posters (metadata.posterPhone).
#
# PLAY_REVIEW_BYPASS_PHONES=+919999999999,+918888888888
# Optional: Firebase UIDs for same accounts (Firebase console → Users):
# PLAY_REVIEW_BYPASS_UIDS=<uid_poster_9999>,<uid_tasker_8888>
# Optional test inboxes (lowercase match) — GET /profiles/me returns isEmailVerified + emailVerifiedAt:
# PLAY_REVIEW_BYPASS_EMAILS=tester@example.com,review+eh@yourdomain.com

# ============================================
# Circuit breaker — messaging-service outages must not block signup
# MESSAGING_SERVICE_URL=http://localhost:4010
# MESSAGING_CIRCUIT_FAILURE_THRESHOLD=5
# MESSAGING_CIRCUIT_RESET_MS=120000

# MyOperator / WhatsApp (signup + event templates)
# ============================================
# MYOPERATOR_BEARER_TOKEN=
# MYOPERATOR_COMPANY_ID=
# MYOPERATOR_WHATSAPP_PHONE_NUMBER_ID=1053314897867813
# MYOPERATOR_SIGNUP_WA_TEMPLATE_ID=
# MYOPERATOR_SIGNUP_WA_TEMPLATE_NAME=copy_extrahand_existing_taskerdata_campaign
# MYOPERATOR_SIGNUP_WA_BUTTON_0_VAR_1=signup
# MYOPERATOR_SIGNUP_WA_BUTTON_1_VAR_1=insta
#
# UTILITY templates (set template UUID after Meta approval; sends skipped until set):
# MYOPERATOR_WA_OFFER_RECEIVED_TEMPLATE_ID=
# MYOPERATOR_WA_TASK_ASSIGNED_TEMPLATE_ID=
# MYOPERATOR_WA_COUNTER_OFFER_RECEIVED_TEMPLATE_ID=
# MYOPERATOR_WA_EARNINGS_CREDITED_TEMPLATE_ID=
# ... see src/config/whatsappTemplates.ts for full list

# ============================================
# Rewards / ExtraCoins (Phase 1 — do not disable v2)
# ============================================
REWARDS_V2_ENABLED=true
CREDITS_WRITES_DISABLED=true
REWARDS_EXTENDED_QUALIFICATION=true
REWARDS_CANONICAL_UID=true
