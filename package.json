{
  "name": "extrahand-user-service",
  "version": "1.0.0",
  "description": "User Service for ExtraHand Platform - Handles authentication, profiles, and user-related operations",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prod": "NODE_ENV=production node dist/server.js",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "eslint src --ext .ts",
    "health": "curl -f http://localhost:4001/api/v1/health || exit 1",
    "seed": "npx ts-node --require dotenv/config scripts/seed-test-user.ts",
    "migrate:drop-credits-tx-index": "npx ts-node --require dotenv/config scripts/drop-credits-transactionId-index.ts",
    "migrate:roles-requester-to-poster": "npx ts-node --require dotenv/config scripts/migrate-roles-requester-to-poster.ts",
    "migrate:profile-both-token-to-dual-roles": "npx ts-node --require dotenv/config scripts/migrate-profile-both-token-to-dual-roles.ts",
    "migrate:profile-client-type-from-sessions": "npx ts-node --require dotenv/config scripts/migrate-profile-client-type-from-sessions.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "aws-sdk": "^2.1691.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^12.5.0",
    "helmet": "^7.1.0",
    "mongodb": "^7.4.0",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "node-cron": "^4.2.1",
    "winston": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-sdk": "^2.7.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
